#!/bin/bash
# pre-commit hook — eu-political-observatory
#
# ESTA es la copia canónica y versionada. La activa `core.hooksPath=hooks`.
# Antes vivía solo en `.git/hooks/`, que no viaja con el repo: era invisible, no
# revisable y se perdía en cada clon. Ver `hooks/README.md`.
#
# Check 1: R methodology guards (lrscale en EFA, escrituras en data/raw/)
# Check 2: sintaxis Python (vigilante de capa-normativa, con reserva inline)
# Check 3: credenciales en ficheros versionados

set -uo pipefail
export LANG=C.UTF-8

# ── Rutas a herramientas externas ────────────────────────────────────────────
# Absolutas y locales de cada máquina, así que NO se codifican aquí: se leen de la
# config del clon, con el layout de la máquina de origen como valor por defecto.
#   git config hooks.vigilanteRepo "/ruta/a/capa-normativa"
#   git config hooks.secretScan    "/ruta/a/vigilante_pre_commit.py"
cfg() { git config --get "$1" 2>/dev/null || true; }

VIGILANTE_REPO="$(cfg hooks.vigilanteRepo)"
: "${VIGILANTE_REPO:=C:/Users/Guille/proyectos/capa-normativa}"

SECRET_SCAN="$(cfg hooks.secretScan)"
: "${SECRET_SCAN:=C:/Users/Guille/proyectos/.claude/hooks/vigilante_pre_commit.py}"

FAILED=0

# ── Check 1: R methodology guards ────────────────────────────────────────────
STAGED_R=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(\.R$|src/analysis/|notebooks/)' || true)

if [ -n "$STAGED_R" ]; then
    for FILE in $STAGED_R; do
        [ -f "$FILE" ] || continue

        if grep -nP '^(?!\s*#).*lrscale' "$FILE" | grep -qP '(fa\.|fa\.pooled|variables_efa|vars_efa|efa_vars|vars\.efa)'; then
            echo "❌ pre-commit: $FILE — lrscale detectado en variables de entrada EFA"
            echo "   lrscale es variable de validación y NUNCA debe entrar en EFA (circularidad)"
            grep -nP '^(?!\s*#).*lrscale' "$FILE" | grep -P '(fa\.|fa\.pooled|variables_efa|vars_efa|efa_vars|vars\.efa)' | head -5
            FAILED=1
        fi

        if grep -nP '^(?!\s*#).*"lrscale"' "$FILE" | grep -qP '(c\(|vars|variables|efa)'; then
            echo "❌ pre-commit: $FILE — lrscale en vector de variables (posible entrada EFA)"
            grep -nP '^(?!\s*#).*"lrscale"' "$FILE" | grep -P '(c\(|vars|variables|efa)' | head -5
            FAILED=1
        fi

        if grep -nP '^(?!\s*#).*(write\.csv|write_csv|saveRDS|write\.table|fwrite)\s*\(' "$FILE" | grep -qP 'data/raw/'; then
            echo "❌ pre-commit: $FILE — intento de escritura en data/raw/ (solo lectura)"
            grep -nP '^(?!\s*#).*(write\.csv|write_csv|saveRDS|write\.table|fwrite)\s*\(' "$FILE" | grep -P 'data/raw/' | head -5
            FAILED=1
        fi
    done
fi

if [ "$FAILED" -eq 1 ]; then
    echo ""
    echo "Commit bloqueado por reglas de metodología ESS."
    exit 1
fi

# ── Check 2: sintaxis Python — ningún .py versionado que no parsee ───────────
# Por qué existe: el 2026-08-09 se encontró un SyntaxError con DOS MESES commiteado en
# src/ingestion/load_ardeco.py (commit 0a2d012, 2026-06-10) que ninguno de los mecanismos
# de solidez del repo había visto. El vigilante de capa-normativa lo cazó en 30 segundos.
#
# Camino 1: el detector `sintaxis` del vigilante (canónico).
# Camino 2: si el vigilante no está disponible (repo movido, rama distinta, exit 2),
#           ast.parse inline sobre los .py en stage. NO se falla en abierto: un guard que
#           desaparece en silencio cuando cambia un repo vecino es justamente el fallo que
#           venimos a cerrar.
REPO_ROOT=$(git rev-parse --show-toplevel)
SYN_DONE=0

if [ -d "$VIGILANTE_REPO/src/capa_normativa/vigilante" ]; then
    SYN_OUT=$(cd "$VIGILANTE_REPO" && PYTHONPATH=src python -m capa_normativa.vigilante.cli \
                  "$REPO_ROOT" --detector sintaxis 2>&1)
    SYN_EXIT=$?
    if [ "$SYN_EXIT" -eq 1 ]; then
        echo "❌ pre-commit: fichero Python versionado que no parsea"
        echo "$SYN_OUT"
        echo ""
        echo "Commit bloqueado por el detector de sintaxis (capa-normativa/vigilante)."
        exit 1
    elif [ "$SYN_EXIT" -eq 0 ]; then
        SYN_DONE=1
    else
        echo "⚠️  pre-commit: el vigilante no pudo ejecutarse (exit $SYN_EXIT) — usando el chequeo de reserva"
        echo "$SYN_OUT"
    fi
fi

if [ "$SYN_DONE" -eq 0 ]; then
    STAGED_PY=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$' || true)
    SYN_FAILED=0
    for FILE in $STAGED_PY; do
        [ -f "$FILE" ] || continue
        # utf-8-sig, no utf-8: con utf-8 el BOM sobrevive y ast lo lee como carácter
        # ilegal en la columna 1 — falso positivo sobre un fichero que Python compila.
        if ! python -c "import ast,sys; ast.parse(open(sys.argv[1],encoding='utf-8-sig').read(), filename=sys.argv[1])" "$FILE"; then
            echo "❌ pre-commit: $FILE — no parsea"
            SYN_FAILED=1
        fi
    done
    if [ "$SYN_FAILED" -eq 1 ]; then
        echo ""
        echo "Commit bloqueado: hay Python que no compila."
        exit 1
    fi
fi

# ── Check 3: credenciales en ficheros versionados ─────────────────────────────
# Antes esto llamaba a security_review.py, que como pre-commit hacía `exit 0` incondicional
# (git no le pasa JSON por stdin, su json.loads reventaba y el except tragaba). Ahora es el
# mismo escáner determinista del vigilante, sin red. Contrato: 0 limpio · 1 hallazgos ·
# 2 no se pudo ejecutar; los dos últimos bloquean, igual que en el Check 2.
if [ ! -f "$SECRET_SCAN" ]; then
    echo "❌ pre-commit: no existe el escáner de credenciales en:"
    echo "     $SECRET_SCAN"
    echo "   El escaneo NO se ha ejecutado, así que el commit se bloquea (a propósito)."
    echo "   Apúntalo a su ruta en esta máquina:"
    echo "     git config hooks.secretScan \"/ruta/a/vigilante_pre_commit.py\""
    exit 1
fi

python "$SECRET_SCAN" --pre-commit
SEC_EXIT=$?
if [ "$SEC_EXIT" -ne 0 ]; then
    echo ""
    echo "Commit bloqueado por el escáner de credenciales (exit $SEC_EXIT)."
    exit 1
fi

exit 0
