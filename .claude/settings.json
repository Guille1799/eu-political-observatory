{
  "model": "claude-sonnet-5",
  "fallbackModel": ["claude-opus-4-8", "claude-sonnet-5"],
  "permissions": {
    "deny": [
      "Write(eu-political-observatory/data/raw/**)",
      "Edit(eu-political-observatory/data/raw/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/preuse_dispatcher.py\"",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate_eu.py\"",
            "timeout": 35
          }
        ]
      }
    ]
  }
}
